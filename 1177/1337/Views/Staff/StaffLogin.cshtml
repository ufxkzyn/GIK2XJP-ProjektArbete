@{
}

<h1>Staff Login</h1>
@if (ViewBag.ErrorMessage != null)
{
		<div class="alert alert-danger">
			@ViewBag.ErrorMessage
		</div>
}

<form asp-controller="Staff" asp-action="StaffLogin" method="post">
	<div class="form-group mb-3">
		<label for="StaffId">Personnummer:</label>
		<input type="text" class="form-control" id="StaffId" name="StaffId" required/>
	</div>

	<div class="form-group mb-3">
		<label for="StaffPW">Lösenord:</label>
		<input type="password" class="form-control" id="StaffPW" name="StaffPW" required/>
	</div>

	<button type="submit" class="btn btn-primary">Login</button>
</form>
