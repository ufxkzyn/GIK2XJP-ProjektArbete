@section Styles {
    <link rel="stylesheet" href="~/css/Patient_home.css" asp-append-version="true" />
}
@model (DateTime Date, string Name)

<div class="patient-home">

    <header class="patient-welcome">
        <h1>
            Välkommen till din startsida @Model.Name!
        </h1>

        <p>
            Dagens datum är @Model.Date.ToString("yyyy-MM-dd").
            Vad vill du göra?
        </p>
    </header>

    <div class="patient-actions">

        <a class="btn btn-primary"
           asp-controller="Patient"
           asp-action="PatientRequest">
            Skicka en ny behandlingsförfrågan
        </a>

        <a class="btn btn-primary"
           asp-controller="Patient"
           asp-action="empty">
            Visa dina bokade tider
        </a>

        <a class="btn btn-primary"
           asp-controller="Patient"
           asp-action="PatientLogout">
            Logga ut
        </a>

    </div>

</div>