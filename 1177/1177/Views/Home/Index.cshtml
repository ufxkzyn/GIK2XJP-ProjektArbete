                <li>
                    <a class="dropdown-item"
                       asp-controller="Hospital"
                       asp-action="Hospital2">
                        Sjukhus Gävleborg
                    </a>
                </li>

                <li>
                    <a class="dropdown-item"
                       asp-controller="Hospital"
                       asp-action="Hospital3">
