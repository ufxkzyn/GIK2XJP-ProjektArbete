<div class="Header">
    <span class="welcome-label">VÅRD OCH HÄLSA</span>

    <h1>Welcome to Our Medical Website</h1>

    <p class="Header-description">
        Find the healthcare information you need.
        Explore hospitals in your region and discover
        helpful information about our healthcare services.
    </p>

    <div class="Header-actions">

        <div class="dropdown">
            <button class="btn btn-hospital dropdown-toggle"
                    type="button"
                    id="hospitalDropdown"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
                <span class="button-icon">+</span>
                Find a Hospital
            </button>

            <ul class="dropdown-menu hospital-menu"
                aria-labelledby="hospitalDropdown">

                <li>
                    <a class="dropdown-item"
                       asp-controller="Hospital"
                       asp-action="Hospital1">
                        <span class="hospital-icon">+</span>
                        <span>
                            <strong>Sjukhus Dalarna</strong>
                            <small>Healthcare in Dalarna</small>
                        </span>
                    </a>
                </li>

                <li>
                    <a class="dropdown-item"
                       asp-controller="Hospital"
                       asp-action="Hospital2">
                        <span class="hospital-icon">+</span>
                        <span>
                            <strong>Sjukhus Gävleborg</strong>
                            <small>Healthcare in Gävleborg</small>
                        </span>
                    </a>
                </li>

                <li>
                    <a class="dropdown-item"
                       asp-controller="Hospital"
                       asp-action="Hospital3">
                        <span class="hospital-icon">+</span>
                        <span>
                            <strong>Sjukhus Västernorrland</strong>
                            <small>Healthcare in Västernorrland</small>
                        </span>
                    </a>
                </li>

            </ul>
        </div>

        <a class="btn btn-information"
           asp-controller="Information"
           asp-action="Information1">
            More Information
            <span aria-hidden="true">&rarr;</span>
        </a>

    </div>

    <div class="trust-note">
        <span class="trust-check" aria-hidden="true">&#10003;</span>
        <span>Healthcare information in one place</span>
    </div>
</div>
<img src="/images/Doctor.png"
     alt="Doctor"
     class="img-fluid mt-4" />
