@model List<_1177.Models.AppointmentSlot>

    <h1>Doktorns tidsschema</h1>

    <a asp-action="Create">Lägg till ny tid</a>

    <ul>
        @foreach (var slot in Model) 
    {
        <li>
            @slot.DoctorName:
            @slot.StartTime.ToString("yyyy-MM-dd HH:mm") -
            @slot.EndTime.ToString("HH:mm")
        </li>
    }
    </ul>
