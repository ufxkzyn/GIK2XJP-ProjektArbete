@model System.Text.Json.Nodes.JsonNode

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@Model["Patient"]</h5>
        <p class="card-subtitle text-muted">@Model["Födelsedatum"] · @Model["Date"]</p>
        <p class="card-text mt-2">@Model["Request"]</p>
    </div>
</div>

<form asp-controller="Staff" asp-action="OpenPatientRequest" method="post">
    <p>Prioritet:1 är högst prioritet</p>
    <input type="radio" name="priority" value="1" required /> 1
    <input type="radio" name="priority" value="2" /> 2
    <input type="radio" name="priority" value="3" /> 3
    <input type="radio" name="priority" value="4" /> 4
    <input type="radio" name="priority" value="5" /> 5

    <label for="staffComment">Kommentar</label>
    <textarea id="staffComment" name="staffComment" class="form-control"></textarea>

    <button type="submit" class="btn btn-primary">Spara</button>
</form>