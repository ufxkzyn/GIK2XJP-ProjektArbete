@model (DateTime Date, string Name)

<header>
    <h1>Välkommen till din startsida @Model.Name, Dagens datum är @Model.Date: vad vill du göra?</h1>
</header>


<div>
    <a class="btn btn-primary" asp-area="" asp-controller="Staff" asp-action="StaffRequestRead">Visa alla behandlingsförfrågningar</a>
</div>


<div>
    <a class="btn btn-primary" asp-area="" asp-controller="Staff" asp-action="empty">Visa alla bokade tider</a>
</div>


<div>
    <a class="btn btn-primary" asp-area="" asp-controller="Staff" asp-action="StaffLogout">Logga ut</a>
</div>