@using System.Text.Json.Nodes
@model JsonNode
@{
    ViewData["Title"] = "Patientförfrågan";

    var bookings = ViewBag.Bookings as List<JsonObject> ?? new();
    var roomPicked = ViewBag.RoomPicked as string;
    var StaffPicked = ViewBag.StaffPicked as string;

    var roomTypes = new Dictionary<string, string>
    {
        ["EmergencyRooms"] = "Akutrum",
        ["TreatmentRoom"] = "BehandlingsRum",
        ["ExaminationRooms"] = "Undersökningsrum"
    };
    var StaffTypeConfused = new Dictionary<string, string>
    {
        ["Doctors"] = "Läkare",
        ["Nurses"] = "Sjuksköterska",
        ["AssistantNurse"] = "Undersköterska"
    };

    var freeStaff = JsonNode.Parse(ViewBag.FreeStaff as string ?? "{}")!.AsObject();
    var patientName = Model["Patient"]?.ToString();

    var weekDays = new[] { "Måndag", "Tisdag", "Onsdag", "Torsdag", "Fredag", "Lördag", "Söndag" };
}

@section Styles {
    <link rel="stylesheet" href="~/css/test.css" asp-append-version="true" />
}

<div class="container py-4">

    <!-- Patient information -->
    <div class="card patient-card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="section-label">PATIENTFÖRFRÅGAN</span>
                    <h4 class="mt-2 mb-1">@Model["Patient"]</h4>
                    <p class="text-muted mb-0">@Model["Födelsedatum"] · @Model["Date"]</p>
                </div>
                <span class="status-badge">
                    <span class="status-dot"></span>
                    Väntar på behandling
                </span>
            </div>
            <hr />
            <h6>Patientens önskemål</h6>
            <p class="mb-0">@Model["Request"]</p>
        </div>
    </div>

    <div class="row g-4">

        <!-- Priority and comment -->
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Bedöm förfrågan</h5>
                    <p class="text-muted small">Ange prioritet och eventuell kommentar.</p>

                    <form asp-controller="Staff" asp-action="OpenPatientRequest" method="post" id="requestForm">

                        <fieldset class="mb-4">
                            <legend class="form-label fw-semibold">Prioritet</legend>
                            <div class="priority-container">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <label class="priority-option priority-@i" for="prio@(i)">
                                        <input type="radio" name="priority" id="prio@(i)" value="@i" required />
                                        <span class="priority-number">@i</span>
                                        <span class="priority-description">
                                            @(i == 1 ? "Akut" :
                                              i == 2 ? "Mycket hög" :
                                              i == 3 ? "Normal" :
                                              i == 4 ? "Låg" : "Mycket låg")
                                        </span>
                                    </label>
                                }
                            </div>
                            <small class="text-muted">1 = Högsta prioritet · 5 = Lägsta prioritet</small>
                        </fieldset>

                        <div class="mb-3">
                            <label for="staffComment" class="form-label fw-semibold">Personalkommentar</label>
                            <textarea id="staffComment" name="staffComment" class="form-control"
                                      rows="4" maxlength="500" placeholder="Skriv en kommentar..."></textarea>
                            <div class="d-flex justify-content-between mt-1">
                                <small class="text-muted">Kommentar till förfrågan</small>
                                <small id="charCounter" class="text-muted">0 / 500</small>
                            </div>
                        </div>

                        <div class="preview-box mb-3">
                            <h6>Förhandsvisning</h6>
                            <p class="mb-1"><strong>Prioritet:</strong> <span id="previewPriority">Inte vald</span></p>
                            <p class="mb-0"><strong>Kommentar:</strong> <span id="previewComment">Ingen kommentar</span></p>
                        </div>

                        <button type="submit" class="btn btn-primary w-100" id="saveButton">
                            <span id="saveButtonText">Spara bedömning</span>
                            <span id="saveSpinner" class="spinner-border spinner-border-sm ms-2 d-none" role="status"></span>
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Room type + staff role -->
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Välj rumstyp och arbetsroll</h5>
                    <p class="text-muted small">Uppdaterar listan över ledig personal.</p>

                    <form asp-action="StaffRequestRead" method="get" id="roomForm">
                        <div class="mb-3">
                            <label for="roomPicked" class="form-label fw-semibold">Rumstyp</label>
                            <select id="roomPicked" name="roomPicked" class="form-select">
                                <option value="" disabled selected="@(roomPicked is null)">Välj rumstyp</option>
                                @foreach (var (value, label) in roomTypes)
                                {
                                    <option value="@value" selected="@(roomPicked == value)">@label</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="StaffPicked" class="form-label fw-semibold">Arbetsroll</label>
                            <select id="StaffPicked" name="StaffType" class="form-select">
                                <option value="" disabled selected="@(StaffPicked is null)">Välj arbetsroll</option>
                                @foreach (var (value, label) in StaffTypeConfused)
                                {
                                    <option value="@value" selected="@(StaffPicked == value)">@label</option>
                                }
                            </select>
                        </div>

                        <button type="submit" class="btn btn-outline-primary w-100">Uppdatera</button>
                    </form>
                </div>
            </div>
        </div>
    </div> @* end row *@
        <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Ledig personal</h5>

            @if (freeStaff.Count == 0)
            {
                <p class="text-muted mb-0">Välj rumstyp och arbetsroll ovan för att se ledig personal.</p>
            }

            @foreach (var (rum, roomNode) in freeStaff)
            {
                <h6 class="mt-3">Rum @rum</h6>

                @foreach (var dag in weekDays)
                {
                    if (roomNode?[dag] is not JsonObject times) continue;

                    var openSlots = times.Where(t => t.Value is JsonArray people && people.Count > 0).ToList();
                    if (openSlots.Count == 0) continue;

                    <details class="mb-2">
                        <summary>@dag (@openSlots.Count lediga tider)</summary>

                        @foreach (var (tid, peopleNode) in openSlots)
                        {
                            <div class="d-flex align-items-center gap-2 flex-wrap py-2 border-bottom">
                                <span class="badge bg-secondary">@tid</span>

                                @foreach (var person in peopleNode!.AsArray())
                                {
                                    var firstName = person?["FirstName"]?.ToString();
                                    var lastName = person?["LastName"]?.ToString();
                                    var pnr = person?["personnummer"]?.ToString();
                                    var roll = person?["Roll"]?.ToString();

                                    <form asp-controller="Staff" asp-action="ConfirmBooking" method="post" class="d-inline">
                                        <input type="hidden" name="patient" value="@patientName" />
                                        <input type="hidden" name="rum" value="@rum" />
                                        <input type="hidden" name="dag" value="@dag" />
                                        <input type="hidden" name="tid" value="@tid" />
                                        <input type="hidden" name="personnummer" value="@pnr" />
                                        <input type="hidden" name="FirstName" value="@firstName" />
                                        <input type="hidden" name="LastName" value="@lastName" />
                                        <input type="hidden" name="Roll" value="@roll" />
                                        <input type="hidden" name="roomPicked" value="@roomPicked" />
                                        <input type="hidden" name="StaffType" value="@StaffPicked" />

                                        <button type="submit" class="btn btn-sm btn-outline-success"
                                                onclick="return confirm('Boka @firstName @lastName, @dag kl. @tid')">
                                            @firstName @lastName
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                    </details>
                }
            }
        </div>
    </div>

</div> @* end container *@