@model System.Text.Json.Nodes.JsonNode
@{
    ViewData["Title"] = "Patientförfrågan";
    var bookings = ViewBag.Bookings as List<System.Text.Json.Nodes.JsonObject> ?? new();
    var roomPicked = ViewBag.RoomPicked as string;

    var roomTypes = new Dictionary<string, string>
    {
        ["EmergencyRooms"] = "Akutrum",
        ["TreatmentRoom"] = "BehandlingsRum",
        ["ExaminationRooms"] = "Undersökningsrum"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/test.css" asp-append-version="true" />
}

@* ---------- Patient request ---------- *@
<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@Model["Patient"]</h5>
        <p class="card-subtitle text-muted">@Model["Födelsedatum"] · @Model["Date"]</p>
        <p class="card-text mt-2">@Model["Request"]</p>
    </div>
</div>

@* ---------- Priority + comment ---------- *@
<form asp-controller="Staff" asp-action="OpenPatientRequest" method="post" class="mb-4">
    <fieldset class="mb-3">
        <legend class="fs-6">Prioritet (1 är högst)</legend>
        @for (int i = 1; i <= 5; i++)
        {
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="priority" id="prio@(i)" value="@i" required />
                <label class="form-check-label" for="prio@(i)">@i</label>
            </div>
        }
    </fieldset>

    <div class="mb-3">
        <label for="staffComment" class="form-label">Kommentar</label>
        <textarea id="staffComment" name="staffComment" class="form-control" rows="3"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Spara</button>
</form>

@* ---------- Room type picker ---------- *@
<form asp-action="StaffRequestRead" method="get" class="mb-4">
    <label for="roomPicked" class="form-label">Rumstyp</label>
    <select id="roomPicked" name="roomPicked" class="form-select" onchange="this.form.submit()">
        <option value="" disabled selected="@(roomPicked is null)">Välj rumstyp</option>
        @foreach (var (value, label) in roomTypes)
        {
            <option value="@value" selected="@(roomPicked == value)">@label</option>
        }
    </select>
</form>

@* ---------- Room schedule grid ---------- *@
@if (roomPicked is not null)
{
    <partial name="RoomDetails" model="bookings" />
}
