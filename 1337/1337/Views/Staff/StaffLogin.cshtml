<link rel="stylesheet" href="~/css/Staff_login.css" />

<h1>Staff Login</h1>

@if (ViewBag.ErrorMessage != null)
{
	<div class="alert alert-danger">
		@ViewBag.ErrorMessage
	</div>
}

<form asp-controller="Staff" asp-action="StaffLogin" method="post">

	<div class="form-check-group mb-3">
		<label for="StaffId">Personnummer:</label>
		<input type="text"
			   class="form-control"
			   id="StaffId"
			   name="StaffId"
			   placeholder="YYYYMMDD-XXXX"
			   required />

	</div>

	<div class="form-group mb-3">
		<label for="StaffPW">Password:</label>
		<input type="password"
			   class="form-control"
			   id="StaffPW"
			   name="StaffPW"
			   placeholder="Password"
			   required />
	</div>
	<button type="submit" class="btn btn-primary">
		log in
	</button>

</form>